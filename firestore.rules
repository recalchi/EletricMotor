rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Cliente nunca grava dado REAL: isso é exclusivo do futuro serviço de ingestão (Admin SDK).
    function noRealOrigin() {
      return !('origin' in request.resource.data) || request.resource.data.origin in ['ESTIMADO', 'SIMULADO', 'INDISPONIVEL'];
    }
    function sizeOk() {
      return request.resource.data.size() <= 40;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /vehicles/{vehicleId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && sizeOk();

        match /{collection}/{docId} {
          allow read: if isOwner(uid);
          allow delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && collection in ['maintenance', 'inspections', 'chargingSessions', 'batteryReadings', 'symptoms', 'alerts', 'auditLog', 'meta']
            && noRealOrigin()
            && sizeOk();
        }
      }
    }

    // Tudo o mais é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
