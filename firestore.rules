rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Cliente nunca grava dado REAL: isso é exclusivo da função de ingestão (Admin SDK).
    function noRealOrigin() {
      return !('origin' in request.resource.data) || request.resource.data.origin in ['ESTIMADO', 'SIMULADO', 'INDISPONIVEL'];
    }
    function sizeOk() {
      return request.resource.data.size() <= 40;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Resultados do scanner enviados para análise (texto JSON). Só criação/leitura/exclusão pelo dono.
      match /scans/{scanId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 900000
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount <= 200;
        match /chunks/{n} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.jsonl is string
            && request.resource.data.jsonl.size() < 900000;
        }
      }

      match /vehicles/{vehicleId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && sizeOk();

        // Coleções gravadas apenas pelo servidor (função de ingestão): leitura do dono, escrita negada.
        match /telemetryLatest/{docId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /telemetryAggregates/{docId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /deviceTests/{docId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if false;
        }

        // Cadastro de dispositivos: o dono gerencia; status só pode assumir valores conhecidos.
        match /devices/{deviceId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.id == deviceId
            && request.resource.data.status in ['teste', 'validado', 'desativado']
            && request.resource.data.channels is list
            && request.resource.data.channels.size() <= 32
            && sizeOk();
        }

        match /{collection}/{docId} {
          allow read: if isOwner(uid);
          allow delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && collection in ['maintenance', 'inspections', 'chargingSessions', 'batteryReadings', 'symptoms', 'alerts', 'auditLog', 'meta']
            && noRealOrigin()
            && sizeOk();
        }
      }
    }

    // Índice global deviceId → dono (usado pela função de ingestão para autenticar o gateway).
    // Um ID pertence a quem o registrou primeiro; o token nunca é armazenado, só seu hash.
    match /deviceIndex/{deviceId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Tudo o mais é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
