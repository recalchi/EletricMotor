{
  "name": "eletricmotor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "cap:sync": "cap sync android",
    "scans:pull": "node scripts/pull-scans.mjs",
    "rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "esptool-js": "0.6.1",
    "firebase": "10.14.1",
    "framer-motion": "11.11.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "recharts": "2.13.0",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.48.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.13",
    "globals": "15.11.0",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.10.0",
    "vite": "5.4.9",
    "vitest": "2.1.3"
  }
